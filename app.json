{
  "expo": {
    "name": "OurBeckett",
    "slug": "ourbeckett",
    "scheme": "ourbeckett",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0812",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.ourbeckett"
    },
    "android": {
      "package": "app.ourbeckett",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E1065"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OurBeckett needs access to your photos so you can share them with other students.",
          "cameraPermission": "OurBeckett needs camera access so you can take photos to share."
        }
      ],
      "expo-video",
      "@react-native-community/datetimepicker",
      "expo-font"
    ]
  }
}
